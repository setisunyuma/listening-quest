# Listening Quest settings. Copy to .env and fill in. Never commit .env.
# 必須 = required in that setup / 任意 = optional.

# ---- database and storage (Docker Compose) ----
POSTGRES_PASSWORD=change-me            # 必須(本番): PostgreSQL password used by compose
MINIO_ROOT_USER=lq-minio               # 必須(本番): MinIO access key (S3 compatible storage)
MINIO_ROOT_PASSWORD=change-me-too      # 必須(本番): MinIO secret, 8+ characters
LQ_S3_BUCKET=listening-quest           # 任意: bucket name (created automatically)

# ---- without Docker (make dev): local PostgreSQL + local file storage ----
# LQ_DATABASE_URL=postgresql+psycopg://lq:lq@127.0.0.1:55432/lq   # 任意: default shown
# LQ_STORAGE_BACKEND=local                                         # 任意: local | s3

# ---- public HTTPS (iPhone use) ----
LQ_DOMAIN=                             # 必須(本番): host name pointing at the server, e.g. lq.example.com
ACME_EMAIL=                            # 任意: e-mail for Let's Encrypt notices
LQ_PUBLIC_ORIGIN=                      # 必須(本番): https://<LQ_DOMAIN>  (enables the Origin check)
LQ_COOKIE_SECURE=false                 # 必須(本番): true behind HTTPS

# ---- generator CLI -> server ----
LQ_IMPORT_TOKEN=                       # 任意: long random string; enables POST /api/import for the CLI
LQ_SERVER_URL=                         # 任意(CLI側): https://<LQ_DOMAIN>; generate auto-sends to it

# ---- OpenAI (paid; nothing is spent until paid generation is enabled in 教材管理) ----
OPENAI_API_KEY=                        # 任意: server side only. Never put it in NEXT_PUBLIC_* variables.
LQ_CONTENT_MODEL=gpt-6.1-terra         # 任意: structured-output model for writing items
LQ_REVIEW_MODEL=gpt-6.1-terra          # 任意: blind reviewer model
LQ_TTS_PROVIDER=openai_realtime        # 任意: openai_realtime (default) | openai_speech (deprecated, shuts down 2027-01-06)
LQ_TTS_MODEL=gpt-realtime-2.1-mini     # 任意: Realtime speech model
LQ_TTS_SPEECH_MODEL=gpt-4o-mini-tts    # 任意: only for openai_speech
LQ_ASR_MODEL=gpt-transcribe            # 任意: independent speech recognition for audio checks
LQ_TTS_NARRATOR_VOICE=cedar            # 任意
LQ_TTS_JA_VOICE=marin                  # 任意: voice for the Japanese explanations
LQ_TTS_SPEAKER_VOICES=alloy,ash,coral,sage,echo,shimmer,verse,ballad   # 任意: one fixed voice per speaker
