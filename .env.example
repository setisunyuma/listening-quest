# Listening Quest settings. Copy to .env (in the repository root) and fill in. Never commit .env.
# The API, the worker and the `lq` CLI read this file from any working directory; values set in the
# process environment win. Check what was read (secrets are shown only as "set"):
#   cd services/core && uv run lq config
# 必須 = required for that setup / 任意 = optional.

# ---- production server (infra/compose.prod.yaml) ----
LQ_DOMAIN=                             # 必須(本番): host name pointing at the server, e.g. lq.example.com
ACME_EMAIL=                            # 任意: e-mail for certificate expiry notices (may stay empty)
POSTGRES_PASSWORD=                     # 必須(本番/Compose): long random string, e.g. `openssl rand -hex 24`

# ---- OpenAI (paid). Nothing is spent until paid generation is enabled in 教材管理 (or `lq verify-live`). ----
OPENAI_API_KEY=                        # 任意: server side only. Never put it in NEXT_PUBLIC_* variables.
LQ_CONTENT_MODEL=gpt-6.1-terra         # 任意: structured-output model that writes items
LQ_REVIEW_MODEL=gpt-6.1-terra          # 任意: blind reviewer model
LQ_TTS_PROVIDER=openai_realtime        # 任意: openai_realtime (default) | openai_speech (deprecated, shuts down 2027-01-06)
LQ_TTS_MODEL=gpt-realtime-2.1-mini     # 任意: Realtime speech model
LQ_TTS_SPEECH_MODEL=gpt-4o-mini-tts    # 任意: only for openai_speech
LQ_ASR_MODEL=gpt-transcribe            # 任意: independent speech recognition for audio checks
LQ_TTS_NARRATOR_VOICE=cedar            # 任意
LQ_TTS_JA_VOICE=marin                  # 任意: voice of the Japanese explanations
LQ_TTS_SPEAKER_VOICES=alloy,ash,coral,sage,echo,shimmer,verse,ballad   # 任意: speakers of unknown gender
LQ_TTS_MALE_VOICES=ash,echo,verse,ballad      # 任意: voice_hint=male or label "Man"
LQ_TTS_FEMALE_VOICES=coral,shimmer,sage        # 任意: voice_hint=female or label "Woman"

# ---- generator CLI on another machine -> this server ----
LQ_IMPORT_TOKEN=                       # 任意: long random string; enables POST /api/import
LQ_SERVER_URL=                         # 任意(CLI側): https://<LQ_DOMAIN>; `lq generate` sends READY units there

# ---- development without Docker (make dev): defaults shown ----
# LQ_DATABASE_URL=postgresql+psycopg://lq:lq@127.0.0.1:55432/lq
# LQ_STORAGE_BACKEND=local             # local | s3
# LQ_COOKIE_SECURE=false

# ---- development Compose (infra/compose.yaml) with S3-compatible SeaweedFS ----
# S3_ACCESS_KEY=lq-dev
# S3_SECRET_KEY=lq-dev-secret

# ---- optional external bucket instead of the server volume (e.g. Cloudflare R2) ----
# LQ_STORAGE_BACKEND=s3
# LQ_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# LQ_S3_BUCKET=listening-quest
# LQ_S3_ACCESS_KEY=
# LQ_S3_SECRET_KEY=
