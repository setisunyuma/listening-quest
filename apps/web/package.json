{
  "name": "listening-quest-web",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src e2e e2e-live",
    "typecheck": "tsc --noEmit",
    "contracts": "openapi-typescript ../../packages/contracts/openapi.json -o src/lib/api-types.ts",
    "contracts:check": "openapi-typescript ../../packages/contracts/openapi.json -o /tmp/lq-api-types.ts && diff -q /tmp/lq-api-types.ts src/lib/api-types.ts",
    "e2e:prepare": "bash ../../scripts/e2e-prepare.sh",
    "e2e": "npm run e2e:prepare && playwright test --trace off",
    "e2e:only": "playwright test --trace off"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
