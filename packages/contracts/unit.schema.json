{
 "$defs": {
  "BlankAnswer": {
   "additionalProperties": false,
   "properties": {
    "accepted": {
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "title": "Accepted",
     "type": "array"
    },
    "type": {
     "const": "blank",
     "default": "blank",
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "accepted"
   ],
   "title": "BlankAnswer",
   "type": "object"
  },
  "Choice": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "text": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "id",
    "text"
   ],
   "title": "Choice",
   "type": "object"
  },
  "Clarification": {
   "additionalProperties": false,
   "description": "A permitted check inside the scene (e.g. asking the office). The reply is pre-authored; asking is recorded\nand never counts as first-time understanding.",
   "properties": {
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "informs": {
     "default": [],
     "items": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "title": "Informs",
     "type": "array"
    },
    "label_ja": {
     "maxLength": 120,
     "minLength": 1,
     "title": "Label Ja",
     "type": "string"
    },
    "reply_en": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Reply En",
     "type": "string"
    }
   },
   "required": [
    "id",
    "label_ja",
    "reply_en"
   ],
   "title": "Clarification",
   "type": "object"
  },
  "DistractorReason": {
   "additionalProperties": false,
   "properties": {
    "choice_id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Choice Id",
     "type": "string"
    },
    "reason_ja": {
     "minLength": 1,
     "title": "Reason Ja",
     "type": "string"
    }
   },
   "required": [
    "choice_id",
    "reason_ja"
   ],
   "title": "DistractorReason",
   "type": "object"
  },
  "EvidenceRef": {
   "additionalProperties": false,
   "properties": {
    "element_id": {
     "anyOf": [
      {
       "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Element Id"
    },
    "figure_id": {
     "anyOf": [
      {
       "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Figure Id"
    },
    "utterance_id": {
     "anyOf": [
      {
       "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Utterance Id"
    }
   },
   "title": "EvidenceRef",
   "type": "object"
  },
  "Feedback": {
   "additionalProperties": false,
   "properties": {
    "answer_en": {
     "minLength": 1,
     "title": "Answer En",
     "type": "string"
    },
    "distractors": {
     "default": [],
     "items": {
      "$ref": "#/$defs/DistractorReason"
     },
     "title": "Distractors",
     "type": "array"
    },
    "explanation_ja": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Explanation Ja",
     "type": "string"
    },
    "hint_ja": {
     "default": "",
     "title": "Hint Ja",
     "type": "string"
    }
   },
   "required": [
    "answer_en",
    "explanation_ja"
   ],
   "title": "Feedback",
   "type": "object"
  },
  "Figure": {
   "additionalProperties": false,
   "description": "Structured figure rendered as safe HTML/SVG by the client. No raw HTML is accepted.",
   "properties": {
    "columns": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Columns",
     "type": "array"
    },
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "kind": {
     "enum": [
      "table",
      "list",
      "worksheet",
      "scene_set",
      "chart_bar",
      "picture_set"
     ],
     "title": "Kind",
     "type": "string"
    },
    "note": {
     "default": "",
     "title": "Note",
     "type": "string"
    },
    "pictures": {
     "default": [],
     "items": {
      "$ref": "#/$defs/PicturePanel"
     },
     "title": "Pictures",
     "type": "array"
    },
    "rows": {
     "default": [],
     "items": {
      "$ref": "#/$defs/FigureRow"
     },
     "title": "Rows",
     "type": "array"
    },
    "title": {
     "default": "",
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "id",
    "kind"
   ],
   "title": "Figure",
   "type": "object"
  },
  "FigureCell": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "text": {
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "id",
    "text"
   ],
   "title": "FigureCell",
   "type": "object"
  },
  "FigureRow": {
   "additionalProperties": false,
   "properties": {
    "cells": {
     "items": {
      "$ref": "#/$defs/FigureCell"
     },
     "title": "Cells",
     "type": "array"
    },
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    }
   },
   "required": [
    "id",
    "cells"
   ],
   "title": "FigureRow",
   "type": "object"
  },
  "GlossItem": {
   "additionalProperties": false,
   "properties": {
    "meaning_ja": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Meaning Ja",
     "type": "string"
    },
    "term": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Term",
     "type": "string"
    }
   },
   "required": [
    "term",
    "meaning_ja"
   ],
   "title": "GlossItem",
   "type": "object"
  },
  "LineTranslation": {
   "additionalProperties": false,
   "properties": {
    "ja": {
     "maxLength": 2000,
     "minLength": 1,
     "title": "Ja",
     "type": "string"
    },
    "utterance_id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Utterance Id",
     "type": "string"
    }
   },
   "required": [
    "utterance_id",
    "ja"
   ],
   "title": "LineTranslation",
   "type": "object"
  },
  "MatchItem": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "text": {
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "id",
    "text"
   ],
   "title": "MatchItem",
   "type": "object"
  },
  "MatchingAnswer": {
   "additionalProperties": false,
   "properties": {
    "pairs": {
     "additionalProperties": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "title": "Pairs",
     "type": "object"
    },
    "type": {
     "const": "matching",
     "default": "matching",
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "pairs"
   ],
   "title": "MatchingAnswer",
   "type": "object"
  },
  "MultiSelectAnswer": {
   "additionalProperties": false,
   "properties": {
    "choice_ids": {
     "items": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "minItems": 1,
     "title": "Choice Ids",
     "type": "array"
    },
    "type": {
     "const": "multi_select",
     "default": "multi_select",
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "choice_ids"
   ],
   "title": "MultiSelectAnswer",
   "type": "object"
  },
  "OrderingAnswer": {
   "additionalProperties": false,
   "properties": {
    "order": {
     "items": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "minItems": 2,
     "title": "Order",
     "type": "array"
    },
    "type": {
     "const": "ordering",
     "default": "ordering",
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "order"
   ],
   "title": "OrderingAnswer",
   "type": "object"
  },
  "PicItem": {
   "additionalProperties": false,
   "description": "One drawn element of a picture. Only these kinds / poses exist: the client draws them as simple SVG pictograms,\nso positions, actions, counts, times and short signs - what an answer may depend on - come from checked data.",
   "properties": {
    "flip": {
     "default": false,
     "title": "Flip",
     "type": "boolean"
    },
    "kind": {
     "enum": [
      "person",
      "cat",
      "dog",
      "table",
      "chair",
      "sofa",
      "bed",
      "shelf",
      "window",
      "door",
      "clock",
      "sign",
      "box",
      "bag",
      "book",
      "phone",
      "umbrella",
      "cup",
      "tree",
      "car",
      "bike",
      "bus",
      "train"
     ],
     "title": "Kind",
     "type": "string"
    },
    "label": {
     "default": "",
     "maxLength": 12,
     "title": "Label",
     "type": "string"
    },
    "pose": {
     "default": "",
     "enum": [
      "",
      "stand",
      "sit",
      "sleep",
      "walk",
      "run",
      "raise_hand",
      "hold",
      "read",
      "call"
     ],
     "title": "Pose",
     "type": "string"
    },
    "size": {
     "default": 100,
     "maximum": 200,
     "minimum": 50,
     "title": "Size",
     "type": "integer"
    },
    "x": {
     "maximum": 100,
     "minimum": 0,
     "title": "X",
     "type": "integer"
    },
    "y": {
     "maximum": 100,
     "minimum": 0,
     "title": "Y",
     "type": "integer"
    }
   },
   "required": [
    "kind",
    "x",
    "y"
   ],
   "title": "PicItem",
   "type": "object"
  },
  "PicturePanel": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "items": {
     "items": {
      "$ref": "#/$defs/PicItem"
     },
     "maxItems": 14,
     "minItems": 1,
     "title": "Items",
     "type": "array"
    }
   },
   "required": [
    "id",
    "items"
   ],
   "title": "PicturePanel",
   "type": "object"
  },
  "PracticeBlock": {
   "additionalProperties": false,
   "properties": {
    "audio_needed_checked": {
     "default": false,
     "title": "Audio Needed Checked",
     "type": "boolean"
    },
    "clarifications": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Clarification"
     },
     "title": "Clarifications",
     "type": "array"
    },
    "curriculum_version": {
     "title": "Curriculum Version",
     "type": "string"
    },
    "generated": {
     "default": true,
     "title": "Generated",
     "type": "boolean"
    },
    "input_mode": {
     "default": "voice_first",
     "enum": [
      "voice_first",
      "desk"
     ],
     "title": "Input Mode",
     "type": "string"
    },
    "items": {
     "items": {
      "$ref": "#/$defs/PracticeItem"
     },
     "minItems": 1,
     "title": "Items",
     "type": "array"
    },
    "listener_ja": {
     "default": "",
     "title": "Listener Ja",
     "type": "string"
    },
    "max_clarifications": {
     "default": 0,
     "maximum": 3,
     "minimum": 0,
     "title": "Max Clarifications",
     "type": "integer"
    },
    "practice_kind": {
     "enum": [
      "P1A",
      "P1B",
      "P2A",
      "P2B",
      "P3A",
      "P3B",
      "P4A",
      "P4B"
     ],
     "title": "Practice Kind",
     "type": "string"
    },
    "prosody_confirmed": {
     "default": false,
     "title": "Prosody Confirmed",
     "type": "boolean"
    },
    "prosody_required": {
     "default": false,
     "title": "Prosody Required",
     "type": "boolean"
    },
    "purpose_ja": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Purpose Ja",
     "type": "string"
    },
    "scene": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Scene",
     "type": "string"
    },
    "success_ja": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Success Ja",
     "type": "string"
    },
    "support_level": {
     "default": 1,
     "maximum": 4,
     "minimum": 1,
     "title": "Support Level",
     "type": "integer"
    }
   },
   "required": [
    "practice_kind",
    "curriculum_version",
    "purpose_ja",
    "success_ja",
    "scene",
    "items"
   ],
   "title": "PracticeBlock",
   "type": "object"
  },
  "PracticeItem": {
   "additionalProperties": false,
   "description": "One rubric item of a practice task = one question (統合指示書 M01). Choices that are critical\nmisunderstandings are labelled, so good answers elsewhere never offset them.",
   "properties": {
    "accept_choice_ids": {
     "default": [],
     "items": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "title": "Accept Choice Ids",
     "type": "array"
    },
    "critical_choices": {
     "additionalProperties": {
      "enum": [
       "subject",
       "conclusion",
       "negation",
       "number",
       "condition",
       "attribution",
       "certainty"
      ],
      "type": "string"
     },
     "default": {},
     "title": "Critical Choices",
     "type": "object"
    },
    "critical_texts": {
     "additionalProperties": {
      "enum": [
       "subject",
       "conclusion",
       "negation",
       "number",
       "condition",
       "attribution",
       "certainty"
      ],
      "type": "string"
     },
     "default": {},
     "title": "Critical Texts",
     "type": "object"
    },
    "main": {
     "default": true,
     "title": "Main",
     "type": "boolean"
    },
    "pending_if_unmatched": {
     "default": false,
     "title": "Pending If Unmatched",
     "type": "boolean"
    },
    "question_id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Question Id",
     "type": "string"
    },
    "rubric": {
     "maxLength": 32,
     "minLength": 1,
     "title": "Rubric",
     "type": "string"
    },
    "stage": {
     "default": "final",
     "enum": [
      "initial",
      "final"
     ],
     "title": "Stage",
     "type": "string"
    },
    "sub_skills": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Sub Skills",
     "type": "array"
    }
   },
   "required": [
    "question_id",
    "rubric"
   ],
   "title": "PracticeItem",
   "type": "object"
  },
  "PreInfo": {
   "additionalProperties": false,
   "description": "Shown before playback (e.g. Eiken Real-Life situation and question).",
   "properties": {
    "read_seconds": {
     "default": 0,
     "maximum": 120,
     "minimum": 0,
     "title": "Read Seconds",
     "type": "integer"
    },
    "situation_en": {
     "default": "",
     "title": "Situation En",
     "type": "string"
    }
   },
   "title": "PreInfo",
   "type": "object"
  },
  "PresentationProfile": {
   "additionalProperties": false,
   "properties": {
    "choices_read_aloud": {
     "default": false,
     "title": "Choices Read Aloud",
     "type": "boolean"
    },
    "figure_verbalized": {
     "default": false,
     "title": "Figure Verbalized",
     "type": "boolean"
    },
    "kind": {
     "default": "official",
     "enum": [
      "official",
      "audio_arranged",
      "practice"
     ],
     "title": "Kind",
     "type": "string"
    },
    "notes": {
     "default": "",
     "title": "Notes",
     "type": "string"
    }
   },
   "title": "PresentationProfile",
   "type": "object"
  },
  "Question": {
   "additionalProperties": false,
   "properties": {
    "answer": {
     "discriminator": {
      "mapping": {
       "blank": "#/$defs/BlankAnswer",
       "matching": "#/$defs/MatchingAnswer",
       "multi_select": "#/$defs/MultiSelectAnswer",
       "ordering": "#/$defs/OrderingAnswer",
       "single_choice": "#/$defs/SingleChoiceAnswer"
      },
      "propertyName": "type"
     },
     "oneOf": [
      {
       "$ref": "#/$defs/SingleChoiceAnswer"
      },
      {
       "$ref": "#/$defs/MultiSelectAnswer"
      },
      {
       "$ref": "#/$defs/OrderingAnswer"
      },
      {
       "$ref": "#/$defs/MatchingAnswer"
      },
      {
       "$ref": "#/$defs/BlankAnswer"
      }
     ],
     "title": "Answer"
    },
    "choices": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Choice"
     },
     "title": "Choices",
     "type": "array"
    },
    "evidence": {
     "items": {
      "$ref": "#/$defs/EvidenceRef"
     },
     "minItems": 1,
     "title": "Evidence",
     "type": "array"
    },
    "feedback": {
     "$ref": "#/$defs/Feedback"
    },
    "figure_ids": {
     "default": [],
     "items": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "title": "Figure Ids",
     "type": "array"
    },
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "items": {
     "default": [],
     "items": {
      "$ref": "#/$defs/MatchItem"
     },
     "title": "Items",
     "type": "array"
    },
    "prompt_en": {
     "minLength": 1,
     "title": "Prompt En",
     "type": "string"
    },
    "prompt_medium": {
     "default": "screen",
     "enum": [
      "screen",
      "audio",
      "both"
     ],
     "title": "Prompt Medium",
     "type": "string"
    },
    "prompt_timing": {
     "default": "before",
     "enum": [
      "before",
      "after"
     ],
     "title": "Prompt Timing",
     "type": "string"
    },
    "segment_ids": {
     "default": [],
     "items": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "title": "Segment Ids",
     "type": "array"
    },
    "skill_tags": {
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "title": "Skill Tags",
     "type": "array"
    },
    "slot": {
     "maximum": 99,
     "minimum": 1,
     "title": "Slot",
     "type": "integer"
    },
    "type": {
     "default": "single_choice",
     "enum": [
      "single_choice",
      "multi_select",
      "ordering",
      "matching",
      "blank"
     ],
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "id",
    "slot",
    "prompt_en",
    "answer",
    "skill_tags",
    "evidence",
    "feedback"
   ],
   "title": "Question",
   "type": "object"
  },
  "RadioInfo": {
   "additionalProperties": false,
   "properties": {
    "figure_description_en": {
     "default": "",
     "title": "Figure Description En",
     "type": "string"
    },
    "reason": {
     "default": "",
     "title": "Reason",
     "type": "string"
    },
    "supported": {
     "default": true,
     "title": "Supported",
     "type": "boolean"
    }
   },
   "title": "RadioInfo",
   "type": "object"
  },
  "ScoringGroup": {
   "additionalProperties": false,
   "properties": {
    "all_or_nothing": {
     "default": false,
     "title": "All Or Nothing",
     "type": "boolean"
    },
    "id": {
     "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
     "title": "Id",
     "type": "string"
    },
    "points": {
     "minimum": 0,
     "title": "Points",
     "type": "number"
    },
    "question_ids": {
     "items": {
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "type": "string"
     },
     "minItems": 1,
     "title": "Question Ids",
     "type": "array"
    }
   },
   "required": [
    "id",
    "question_ids",
    "points"
   ],
   "title": "ScoringGroup",
   "type": "object"
  },
  "SingleChoiceAnswer": {
   "additionalProperties": false,
   "properties": {
